#!/usr/bin/env bash
#MISE description="Build target/release/presence-bridge"

set -euo pipefail

# See mise/tasks/lint: a stray argument is a mistyped multi-task run.
if [[ $# -gt 0 ]]; then
    echo "build takes no arguments (got: $*). To run several tasks: mise run build ::: test" >&2
    exit 2
fi

cargo build --release --locked
