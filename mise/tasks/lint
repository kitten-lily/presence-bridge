#!/usr/bin/env bash
#MISE description="Check formatting (rustfmt.toml), run clippy with warnings as errors, and lint task #USAGE specs"

set -euo pipefail

# `mise run lint test` runs only this task, with "test" as an argument; the
# form that runs both is `mise run lint ::: test`. Fail rather than pass while
# skipping the tests. docs/skills/mise.md § Running several tasks.
if [[ $# -gt 0 ]]; then
    echo "lint takes no arguments (got: $*). To run several tasks: mise run lint ::: test" >&2
    exit 2
fi

cargo fmt --check
cargo clippy --release --locked --all-targets -- -D warnings

# `usage lint` reads a file as a script only when it carries #USAGE lines;
# otherwise it parses the whole file, shebang included, as a KDL spec and fails
# on line 1. A task with no flags has no spec to check.
# docs/skills/mise.md § Creating a task.
for task in mise/tasks/*; do
    if grep -q '^#USAGE' "$task"; then
        usage lint --warnings-as-errors "$task"
    fi
done
